{
  "$schema": "./network_addressing.schema.json",
  "_comment": "SINGLE SOURCE OF TRUTH for all network IPs. Run 'python scripts/sync_network_config.py' after editing.",
  "environment": {
    "name": "default",
    "description": "Default GNS3 environment configuration"
  },
  "simulator": {
    "type": "gns3",
    "host": "192.168.141.128",
    "api_port": 3080,
    "ssh": {
      "port": 22,
      "username": "gns3",
      "password": "gns3"
    },
    "project_name": "fl_federation",
    "compute_id": "local",
    "_note": "Change 'host' to your GNS3 VM IP address"
  },
  "network": {
    "subnet": "192.168.141.0/24",
    "subnet_prefix": "192.168.141",
    "gateway": "192.168.141.1",
    "ip_ranges": {
      "server": "10-19",
      "policy": "20-29",
      "controller": "30-49",
      "collector": "40-49",
      "northbound": "50-59",
      "ovs": "60-99",
      "clients": "100-255"
    }
  },
  "services": {
    "fl_server": {
      "ip_suffix": 10,
      "port": 8080,
      "metrics_port": 8081
    },
    "policy_engine": {
      "ip_suffix": 20,
      "port": 5000
    },
    "collector": {
      "ip_suffix": 40,
      "port": 8000,
      "external_port": 8001
    },
    "sdn_controller": {
      "ip_suffix": 41,
      "ports": {
        "openflow": 6633,
        "rest": 8181
      }
    },
    "openvswitch": {
      "ip_suffix": 60,
      "ports": {
        "ovsdb": 6640,
        "management": 6634
      }
    },
    "fl_clients": {
      "base_ip_suffix": 101,
      "max_clients": 155
    }
  },
  "northbound": {
    "interface": "eth1",
    "sdn_controller_suffix": 51,
    "collector_suffix": 52
  }
}